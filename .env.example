# ==========================================
# ResolveeAI Zero-Trust Lifecycle Manager
# Environment Configuration Template
# ==========================================

# 1. Zoho Mail API & SMTP Administration
admin_mail=hi@yourcompany.com
zoho_password=your_zoho_app_password
ZOHO_CLIENT_ID=your_zoho_oauth_client_id
ZOHO_CLIENT_SECRET=your_zoho_oauth_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_oauth_refresh_token
ZOHO_ZOID=your_zoho_organization_zoid

# 2. MongoDB Atlas Database SRV
mongodb=mongodb+srv://<username>:<password>@cluster.mongodb.net/

# 3. GitHub Organization REST API Token (Scopes: repo, admin:org)
pat=ghp_your_github_personal_access_token

# 4. AWS Cloud IAM Credentials (Scoped Developer Policy)
AWS_ACCESS_KEY_ID=AKIA_YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# 5. Daytona Cloud Sandbox API Key
daytona=dtn_your_daytona_api_key
